<%- include('../partials/admin-start') %>
<h1>Chuyên mục</h1>
<form method="post" action="/quan-tri/chuyen-muc" class="row box">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input name="name" placeholder="Tên chuyên mục mới" maxlength="80" required>
  <button class="btn btn-primary" type="submit">Thêm</button>
</form>
<div class="table-wrap"><table>
  <thead><tr><th>Tên</th><th>Số bài</th><th></th></tr></thead>
  <tbody>
  <% categories.forEach(function (c) { %>
    <tr>
      <td>
        <form method="post" action="/quan-tri/chuyen-muc/<%= c.id %>" class="row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input name="name" value="<%= c.name %>" maxlength="80" required>
          <button class="btn btn-ghost" type="submit">Lưu tên</button>
        </form>
      </td>
      <td><%= c.articleCount %></td>
      <td class="actions">
        <form method="post" action="/quan-tri/chuyen-muc/<%= c.id %>/xoa" class="inline" data-confirm="Xóa chuyên mục &quot;<%= c.name %>&quot;?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger" <%= c.articleCount ? 'title="Còn bài viết, chưa thể xóa"' : '' %>>Xóa</button></form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<%- include('../partials/admin-end') %>
