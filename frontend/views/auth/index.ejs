<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>
<section class="auth">
  <div class="tabs"><a class="<%= mode === 'login' ? 'on' : '' %>" href="/auth?mode=login">Đăng nhập</a><a class="<%= mode === 'register' ? 'on' : '' %>" href="/auth?mode=register">Đăng ký biên tập viên</a></div>
  <% if (error) { %><div class="flash flash-warning" role="alert"><%= error %></div><% } %>
  <% if (mode === 'login') { %>
    <form method="post" action="/auth/login" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email <input type="email" name="email" value="<%= form.email || '' %>" required autocomplete="username"></label>
      <label>Mật khẩu <input type="password" name="password" required autocomplete="current-password"></label>
      <label class="check"><input type="checkbox" name="rememberMe"> Ghi nhớ đăng nhập</label>
      <button class="btn btn-primary" type="submit">Đăng nhập</button>
    </form>
    <p class="hint">Độc giả không cần tài khoản. Biên tập viên chưa có tài khoản hãy chuyển sang tab "Đăng ký".</p>
  <% } else { %>
    <form method="post" action="/auth/register" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Họ tên <input name="displayName" value="<%= form.displayName || '' %>" maxlength="120" required></label>
      <label>Email <input type="email" name="email" value="<%= form.email || '' %>" required></label>
      <label>Mật khẩu (từ 6 ký tự) <input type="password" name="password" minlength="6" required autocomplete="new-password"></label>
      <label>Nhập lại mật khẩu <input type="password" name="confirmPassword" minlength="6" required autocomplete="new-password"></label>
      <button class="btn btn-primary" type="submit">Tạo tài khoản biên tập viên</button>
    </form>
  <% } %>
</section>
<%- include('../partials/footer') %>
