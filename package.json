  "description": "Tin Tức HaUI - website đọc tin tức có khu quản trị (Express + EJS + Sequelize + MySQL)",
  "main": "backend/server.js",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "nodemon backend/server.js",
